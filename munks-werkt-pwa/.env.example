# demo gebruikt uitsluitend fictieve gegevens in het browsergeheugen.
# api gebruikt dezelfde-origin serverroutes onder /api.
VITE_DATA_MODE=demo

# Zet dit alleen lokaal op supabase om de vier fictieve testaccounts te testen.
VITE_AUTH_MODE=demo
VITE_SUPABASE_URL=https://PROJECT-REF.supabase.co
# Een publishable key (of legacy anon key) mag in de PWA staan. Gebruik hier nooit de service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
